# --- Python virtual environment (large, rebuildable — never commit) ---
.venv/

# --- Python cache files (auto-generated) ---
__pycache__/
*.pyc

# --- Claude Code local config (not part of the project) ---
.claude/

# --- Operating-system junk files ---
Thumbs.db
.DS_Store

# --- Large data: videos & extracted frames (keep on disk, not in git) ---
data/raw_videos/*
data/frames/*

# --- Label Studio export + the split YOLO dataset (lots of images, keep local) ---
data/label_export/
data/dataset/

# --- Public teaching dataset + generated classification crops ---
data/oxford-iiit-pet/
data/classification_crops/

# --- Trained model weights (large binary files) ---
*.pt
*.onnx
models/*

# --- YOLO training/prediction output folders (auto-generated, large) ---
runs/
outputs/

# --- Generated notebook figures and reports ---
reports/

# --- Jupyter notebook autosave junk ---
.ipynb_checkpoints/

# --- Local Codex teaching context (may contain private learner information) ---
CODEX_HANDOFF.md

# ...but DO keep the empty-folder placeholders so the structure survives:
!**/.gitkeep
